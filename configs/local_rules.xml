<!-- P3 custom Wazuh rules -->
<group name="web,accesslog,sql_injection,">
  <rule id="100100" level="10">
    <if_sid>31100</if_sid>
    <url>%27+or+%27|%27+OR+%27|%27%20or%20%27|%27%20OR%20%27</url>
    <description>Custom SQL injection detection: OR tautology attempt.</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>attack,sql_injection,</group>
  </rule>
</group>

<group name="web,accesslog,web_scanning,">
  <rule id="100200" level="10" frequency="8" timeframe="120" ignore="60">
    <if_matched_sid>31101</if_matched_sid>
    <same_source_ip/>
    <description>Custom web directory scanning detection: multiple 4xx responses from same source.</description>
    <mitre>
      <id>T1595.003</id>
    </mitre>
    <group>attack,web_scanning,</group>
  </rule>
</group>
